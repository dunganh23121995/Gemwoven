{
  "note": "Combat voice casting. family = clip prefix in boss-voice-manifest.json (<family>-attack1..3, hurt1..3, cast, release, death). The four original bosses (earth/fire/ice/lightning) use named families so the elemental fallback boss-<element>-* stays unchanged. Elite variants: a = lighter/agile, b = heavy/deep. creatures: common foe id -> species family creature-<group> built from real recordings by scripts/prepare_creature_sfx.py; a foe not listed falls back to creature-<element>.",
  "bosses": {
    "earth": {
      "voice": "treant-golem",
      "family": "boss-grovewarden",
      "note": "Thạch Mộc Cự Vệ: moss-and-stone tree golem, no human face. Real bear roars (craigsmith R19-13), grizzly and angry-bear growls, 10 % slower for size. No layers."
    },
    "fire": {
      "voice": "dragon",
      "family": "boss-ashdragon",
      "note": "Hỏa Long Tro Tàn: red winged dragon. Designed dragon-roar SFX by sound designers (Dreeme: built from real lion, dog, horse, elephant and flamethrower; JoelAudio; AMWD/Stijn Loyen), used as published."
    },
    "ice": {
      "voice": "frost-beast",
      "family": "boss-moonfrost",
      "note": "Băng Nguyệt Linh Hồ: white feathered fox/owl-like beast. Real red-fox screams (Soundburst), 10 % slower. No hiss layer."
    },
    "lightning": {
      "voice": "storm-lion",
      "family": "boss-thunderking",
      "note": "Lôi Sư Thiên Đỉnh: purple maned feline beast. Real lion roars (Bidone, craigsmith G12-47), angry tiger and a single tiger roar, unpitched."
    },
    "mire": {
      "voice": "female",
      "family": "boss-mire",
      "note": "Mẫu Nấm Độc: robed mushroom matron with a staff and hands, humanoid, named \"mother\". Old-witch voice actor (CC0), lowered, with a demonic double."
    },
    "scarab": {
      "voice": "insect-beetle",
      "family": "boss-scarab",
      "note": "Bọ Vương Hoàng Kim: giant golden beetle. Real Madagascar hissing-cockroach hisses (Spoxe; nicotep close-up, a different part than the common beetles), 13 % slower for size."
    },
    "leviathan": {
      "voice": "sea-serpent",
      "family": "boss-leviathan",
      "note": "Hải Long San Hô: teal coral sea serpent. Real alligator growls (craigsmith, D.jones) and crocodile screams (felix.blume), 8 % slower."
    },
    "colossus": {
      "voice": "steam-golem",
      "family": "boss-colossus",
      "note": "Cự Tượng Bánh Răng: brass gear golem, a machine. Real steam-train chuffs, heavy metal doors, creaking metal, steam hiss and a steam whistle; no animal voice."
    },
    "prism": {
      "voice": "insect-queen",
      "family": "boss-prism",
      "note": "Bọ Ngựa Lăng Tinh: crowned crystal mantis/wasp queen. Real wasp and yellow-jacket buzzing, cicada song for the charge."
    },
    "reaper": {
      "voice": "undead-wraith",
      "family": "boss-reaper",
      "note": "Tử Thần Nguyệt Ảnh: hooded reaper, no face, gender not shown. Performed CC0 wraith shrieks (Voices_Of_Marz), creepy moan (titsher), moaning wraith death (gateroadmusic); no pitch or layers."
    },
    "roc": {
      "voice": "giant-bird",
      "family": "boss-roc",
      "note": "Đại Bàng Thiên Phong: giant eagle. Real red-tailed hawk screams (1888software, craigsmith), 10 % slower for size."
    },
    "briar": {
      "voice": "female",
      "family": "boss-briar",
      "note": "Nữ Hoàng Gai: thorn queen, clearly a woman (face, rose crown, gown). Female fighting-grunt actor (CC0) with a light weight double; death from a separate female agony recording."
    },
    "seraph": {
      "voice": "male",
      "family": "boss-seraph",
      "note": "Thiên Sứ Nhật Quang: broad armored winged knight, male build. Male fight grunts for attacks, a male pain-grunt actor for hurt/cast/release/death, lowered with a light double."
    },
    "eclipse": {
      "voice": "void-dragon",
      "family": "boss-eclipse",
      "note": "Long Đế Hư Không: starry void dragon. Designed dragon roars, growls and snarls by Breviceps (two uploads), used as published."
    },
    "elderbloom": {
      "voice": "antlered-treant",
      "family": "boss-elderbloom",
      "note": "Thụ Vương Bạch Hoa: antlered treant. Real moose/elk bellows (gleith), 8 % slower. No wood layers."
    },
    "cinderheart": {
      "voice": "magma-golem",
      "family": "boss-cinderheart",
      "note": "Bạo Chúa Tâm Nham: lava rock golem. Real lion growls and roars (GJ55GB) and an alpha-gorilla roar (J0ck0), 10 % slower."
    },
    "frostregent": {
      "voice": "female",
      "family": "boss-frostregent",
      "note": "Nữ Đế Băng Tinh: ice empress, clearly a woman. Female battle-cry actor (CC0), slightly lowered, cold presence, octave shadow."
    },
    "tempestwing": {
      "voice": "thunderbird",
      "family": "boss-tempestwing",
      "note": "Sư Ưng Lôi Hoàng: armored storm eagle. Real eagle squawks, calls and cries (craigsmith S28-16, G12-35a), unpitched; different recordings from the roc."
    },
    "souljailer": {
      "voice": "undead-jailer",
      "family": "boss-souljailer",
      "note": "Cai Ngục Vong Đăng: hooded lantern wraith, gender not shown. Performed CC0 demon/ghost groans (Osiruswaltz), unpitched."
    },
    "sporefather": {
      "voice": "fungal-giant",
      "family": "boss-sporefather",
      "note": "Lão Vương Bào Tử: mushroom-covered giant with no human face. Real camel grunts and groans and complaining dromedaries, 8 % slower. Borderline: humanoid silhouette and \"father\" in the name."
    },
    "prismback": {
      "voice": "crystal-tortoise",
      "family": "boss-prismback",
      "note": "Huyền Quy Tinh Thành: giant tortoise carrying a crystal citadel. Real hippo grunts (toadie, Zambia) and elephant rumble/growl, 10 % slower."
    },
    "sandchronarch": {
      "voice": "male",
      "family": "boss-sandchronarch",
      "note": "Sa Vương Thời Luân: robed, masked sand king with a humanoid body, a male ruler. Aggressive male growl actor (CC0), lowered, demonic double and sand grit; death from a male scream recording."
    },
    "coraltide": {
      "voice": "sea-dragon",
      "family": "boss-coraltide",
      "note": "Long Vương Châu Triều: coral sea dragon. Designed dragon roar (999999990) for charge, death and one attack; real sea-lion roars and growls (felix.blume, Diim_1) for the rest, 8-10 % slower."
    },
    "moonfang": {
      "voice": "wolf",
      "family": "boss-moonfang",
      "note": "Lang Vương Tử Nguyệt: wolf-headed armored werewolf. Real dog snarls and growls (qubodup), 8 % slower, and a solitary wild wolf howl (betchkal) for cast/death. Borderline: humanoid body, but the head is fully a wolf."
    }
  },
