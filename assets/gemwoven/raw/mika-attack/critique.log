126:const MIKA_SOUNDS={2:['f2-rise','f2-dipbody','f2-dip','f2-flyby','f2-boom','f2-floor'],3:['gather','f3-flare','draw','f3-sweep','cut','f3-sun','finale','f3-wave','flame-whoosh','f3-engulf']};
267:    pending.push(wait(delay+450).then(()=>{if(!reduced){// Each wave bursts with the main sun burst's own sound; after the last, form 1's flame whoosh rings out
268:    // exactly as form 1 plays it (mika-ultimate.js: 'flame-whoosh', volume .48, pan .12).
269:    if(i%3===0){mikaSound('f3-wave',.56,.3);mikaShake(pending,.6);if(i===6){mikaSound('flame-whoosh',.48,.12);pending.push(wait(140).then(()=>mikaEngulf(foe,pending)));}}mikaBurst('impact3',{x:foe.x+(i%3-1)*foe.width*.15,y:foe.y-(i%2)*foe.height*.15},foe.width*.55,pending,{hold:.6,fade:120});}}));

