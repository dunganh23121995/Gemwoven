  }

  // The picker: owned heroes below 6? (never Hiro); a voucher when none qualifies. Before day 28 it only tells the day.
  function picker(ctx,state,voucher){
    const v=G.engine.memory(),c=v.chest,useVoucher=voucher||(!c.ready&&v.vouchers>0);
    const modal=window.GemwovenUI.makeDialog('memory-chest',useVoucher||c.ready?'Ch?n tu?ng':'Ruong ng�y '+c.openDay,'kp-pop memory-dialog');
    const done=got=>{modal.close();ctx.render();if(got.voucher)ctx.showModal('Da c?t phi?u',['ticket'],'Phi?u 20 m?nh kh�ng h?t h?n, n?m trong T�i D? � Kh�c.');
      else ctx.showModal(`+${got.fragments} m?nh ${M.HEROES[got.hero].name}`,['fragment-'+got.hero],`Dang c� ${G.engine.read().fragments[got.hero]||0} m?nh.`);};
    if(!useVoucher&&!c.ready){
      modal.body.innerHTML=`<div class="mem-pop-chest">${img('chest')}</div><p class="mem-pop-tag">${c.fragments} m?nh t? ch?n</p><p class="mem-pop-note">${c.claimed?'Da nh?n m�a n�y � m�a sau ng�y '+c.openDay:`M? ng�y ${c.openDay} � ${date(c.opensAt)}`}</p>`;
      modal.present();return;}
    let pick=c.choices[0]||null;
    if(!c.choices.length){
      modal.body.innerHTML=`<p class="mem-pop-tag">${c.fragments} m?nh</p><div class="mem-pop-chest">${img('ticket')}</div><p class="mem-pop-note">Chua c� tu?ng h?p l? � Phi?u kh�ng h?t h?n</p>`;
      if(!useVoucher){const b=document.createElement('button');b.type='button';b.className='gw-btn';b.textContent='C?t phi?u';
        b.onclick=()=>{try{done(G.engine.claimMemoryChest());}catch(e){ctx.showModal('Chua th? nh?n',[],e.message);}};modal.actions.append(b);}
      modal.present();return;}
    const grid=c.choices.map(k=>{const h=G.engine.read().heroes[k];return `<button type="button" class="mem-hero${k===pick?' is-picked':''}" data-hero="${esc(k)}" aria-pressed="${k===pick}"><span class="mem-socket">${img('portrait-'+k)}</span><b>${esc(M.HEROES[k].name)}</b><small>${'?'.repeat(h.stars)}</small></button>`;}).join('');
    modal.body.innerHTML=`<p class="mem-pop-tag">${c.fragments} m?nh</p><div class="mem-heroes">${grid}</div>`;
    modal.body.addEventListener('click',e=>{const b=e.target.closest('.mem-hero');if(!b)return;pick=b.dataset.hero;for(const x of modal.body.querySelectorAll('.mem-hero')){x.classList.toggle('is-picked',x===b);x.setAttribute('aria-pressed',String(x===b));}});
    const b=document.createElement('button');b.type='button';b.className='gw-btn';b.textContent=`Nh?n ${c.fragments} m?nh`;
    b.onclick=()=>{try{done(useVoucher?G.engine.useMemoryVoucher(pick):G.engine.claimMemoryChest(pick));}catch(e){ctx.showModal('Chua th? nh?n',[],e.message);}};
    modal.actions.append(b);modal.present();
  }

  // S? Ki?n: the row sits under H�nh Tr�nh T�n Th?, before the weekly quests.
  const decorate=G.decorate;
  G.decorate=state=>{
    const p=decorate(state);if(state.screen!=='events')return p;
    const live=L.screens.events?.nodes.find(n=>n.id==='events.live');if(!live||live.memoryWrapped)return p;
