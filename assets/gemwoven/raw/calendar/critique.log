/* D3 memory pieces (memory-ui.js, art-screens.js shop Ky ?c). Panel sizes are stage units (941 wide � 390 CSS px on a
 * phone); the picker popup is CSS px. Drawn pieces: assets/gemwoven/ui-kit (--kit-*), memory-dust.webp, chest, portraits. */

/* S? Ki?n � L?ch 28 ng�y: plaque + ? + day count, the kit progress bar, one chest row. */
.mem-cal{margin:18px 0 8px}
.mem-cal .mem-head{display:flex;align-items:center;gap:10px}
.mem-cal .mem-head .kp-sec{margin:0}
.mem-cal .mem-head details.kp-info{margin:0;position:static}
.mem-cal .mem-head details.kp-info[open]>p{position:absolute;left:24px;right:24px;z-index:3;margin-top:8px}
.mem-cal .mem-day{margin-left:auto;font:800 30px Cambria,serif;color:#5a3a18;white-space:nowrap}
.mem-cal .mem-bar{margin:12px 6px 14px}
.mem-chest{display:flex;align-items:center;gap:18px;width:100%;min-height:124px;padding:12px 26px!important;cursor:pointer;text-align:left;
  background:none!important;border:solid transparent!important;border-width:20px 24px!important;border-image:var(--kit-stat) 26 28 fill / 20px 24px stretch!important;border-radius:0!important;box-shadow:none!important;color:#4a2a10}
.mem-cal.is-ready .mem-chest{border-image-source:var(--kit-stat-on)!important}
.mem-chest:focus-visible{outline:4px solid #fff1b8;outline-offset:3px}
.mem-socket{flex:none;display:flex;align-items:center;justify-content:center;width:104px;height:104px;background:var(--kit-socket) center/100% 100% no-repeat}
.mem-socket img{width:74%;height:74%;object-fit:contain;filter:drop-shadow(0 2px 2px #0007)}
.mem-cal.is-ready .mem-socket{background-image:var(--kit-socket-on)}
.mem-cal.is-ready .mem-socket img{animation:mem-glow 1.6s ease-in-out infinite}
.mem-cal.is-claimed .mem-socket{background-image:var(--kit-socket-claimed)}
.mem-cal.is-claimed .mem-socket img{filter:grayscale(.6) brightness(.85)}
.mem-what{display:flex;flex-direction:column;gap:4px;min-width:0}
.mem-what b{font:800 31px/1.1 Cambria,serif;color:#4a2a10}
.mem-what small{font:700 26px Cambria,serif;color:#2f6a1e}
.mem-tag{margin-left:auto;flex:none;font:800 26px Cambria,serif;font-style:normal;color:#f3dcae;padding:12px 22px;background:var(--kit-badge-leather) center/100% 100% no-repeat;text-shadow:0 1px 2px #1a0c04;white-space:nowrap}
.mem-tag.kp-seal{padding:0 12px;color:#fff4df}
.mem-tag.is-done{background-image:var(--kit-ribbon-done);color:#2c4a14;text-shadow:none}
.mem-voucher{display:flex!important;margin:12px auto 0;width:70%}
.mem-voucher .mem-ticket{width:56px;height:56px;object-fit:contain}
@keyframes mem-glow{50%{filter:drop-shadow(0 0 10px #ffe08a) brightness(1.12)}}
@media (prefers-reduced-motion:reduce){.mem-cal.is-ready .mem-socket img{animation:none}}

/* The picker popup (CSS px): a tag, hero portraits in sockets, the gold kit button from .kp-pop. */
.memory-dialog .gw-body{text-align:center}
.memory-dialog .mem-pop-tag{display:inline-block;margin:4px auto 10px;padding:8px 22px;font:800 17px Cambria,serif;color:#4a2a10;background:var(--kit-stat) center/100% 100% no-repeat}
.memory-dialog .mem-pop-note{font:700 15px/1.35 Cambria,serif;color:#5a3a18;margin:8px 0}
.memory-dialog .mem-pop-chest img{width:110px;height:110px;object-fit:contain;filter:drop-shadow(0 3px 3px #0006)}
.memory-dialog .mem-heroes{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.memory-dialog .mem-hero{display:flex;flex-direction:column;align-items:center;gap:2px;width:96px;padding:4px;background:none;border:0;cursor:pointer;color:#4a2a10}
.memory-dialog .mem-hero .mem-socket{width:78px;height:78px}
.memory-dialog .mem-hero.is-picked .mem-socket{background-image:var(--kit-socket-on);filter:drop-shadow(0 0 6px #ffcf6a)}
.memory-dialog .mem-hero b{font:800 16px Cambria,serif}
.memory-dialog .mem-hero small{font:700 12px Cambria,serif;color:#b07a1c}
.memory-dialog .mem-hero:focus-visible{outline:3px solid #fff1b8}

/* C?a H�ng � Ky ?c (layout nodes in art-screens.js). */
#stage[data-screen="shop"] [data-node="shop.memory-balance"] .copy-layer{font:900 36px/1 Cambria,serif!important;color:#3a2008!important;text-shadow:0 1px #fff3cf!important}
#stage[data-screen="shop"] [data-node="shop.memory-empty"]{font-weight:800!important;line-height:1.25!important;color:#4a2a10!important}
#stage[data-screen="shop"] [data-node="shop.memory-left"]{font-weight:800!important;line-height:1.2!important}
#stage[data-screen="shop"] [data-node="shop.memory-info"] .copy-layer{font:italic 900 34px/1 Cambria,serif!important;color:#4a2508!important;text-shadow:none!important}
#stage[data-screen="shop"] [data-node^="shop.memory-name-"]{font-weight:800!important;color:#f6e2b8!important;text-shadow:0 1px 2px #1a0c04,0 0 4px #1a0c04!important}
/* Codex build review 1 (7,5/7,6): larger reading text in the shop, a gold "Mi?n ph�" plate on the ready chest, bigger popup. */
#stage[data-screen="shop"] .memory-copy[data-node="shop.product-description"]{font-size:37px!important;line-height:1.25!important}
#stage[data-screen="shop"] .memory-copy[data-node="shop.product-name"]{font-size:39px!important}
.mem-go{margin-left:auto;flex:none;display:inline-flex;align-items:center;justify-content:center;min-width:150px;min-height:86px;padding:0 14px;font:900 29px Cambria,serif;font-style:normal;color:#4a2508;text-shadow:0 1px #fff3cf;
  border:solid transparent;border-width:0 30px;border-image:var(--kit-btn-gold) 0 40 fill / 0 30px stretch;filter:drop-shadow(0 4px 3px #2a140866)}
.mem-cal.is-ready .mem-chest:active .mem-go{border-image-source:var(--kit-btn-gold-down)}
.memory-dialog .gw-head h2{font-size:27px!important}
.memory-dialog .mem-pop-tag{font-size:19px}
.memory-dialog .mem-hero{width:116px}
.memory-dialog .mem-hero .mem-socket{width:96px;height:96px}
.memory-dialog .mem-hero b{font-size:18px}
.memory-dialog .mem-heroes{margin-bottom:2px}

