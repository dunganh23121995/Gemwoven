.kp-panel .kp-bar,.kp-pop .kp-bar{position:relative;display:block;height:38px;margin:10px 0 16px;border-radius:0!important;overflow:visible!important;background:none!important;border:solid transparent;border-width:0 20px;border-image:var(--kit-progress) 0 22 fill / 0 20px stretch}
