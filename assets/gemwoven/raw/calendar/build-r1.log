.kp-panel .kp-plaque-in{display:inline-block;padding:14px 34px 16px;background:var(--kit-plaque) center/100% 100% no-repeat;font:800 32px/1 Cambria,serif;color:#f6e2b8;text-shadow:0 1px 2px #1a0c04;white-space:nowrap}
.kp-panel .kp-seal,.kp-pop .kp-seal{display:inline-flex;align-items:center;justify-content:center;min-width:100px;height:68px;padding:0 12px;background:var(--kit-seal) center/100% 100% no-repeat;font:800 26px Cambria,serif;font-style:normal;color:#fff4df;text-shadow:0 1px 2px #5a0c06}
.kp-panel .kp-ico{width:64px;height:64px;object-fit:contain;flex:none;filter:drop-shadow(0 2px 2px #0005)}
.kp-panel .kp-lock,.kp-pop .kp-lock{width:auto;height:1.1em;object-fit:contain;vertical-align:-.15em;filter:drop-shadow(0 1px 1px #0006)}

/* Gold, wooden and steel plates for actions (the drawn plate as a 9-slice so wide buttons keep their ends). */
.kp-panel .game-btn,.kp-panel .kp-gold,.kp-panel .kp-steel,.kp-panel .kp-wood{--h:100px;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:100px;padding:0 34px!important;
  background:none!important;border:solid transparent!important;border-width:0 34px!important;border-image:var(--kit-btn-gold) 0 40 fill / 0 34px stretch!important;box-shadow:none!important;filter:drop-shadow(0 5px 4px #2a140866);
