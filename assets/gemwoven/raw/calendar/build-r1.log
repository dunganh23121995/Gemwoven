4:.cal .cal-head{display:flex;align-items:center;gap:10px;min-height:56px}
5:.cal .cal-head .kp-sec{margin:0}
6:.cal .cal-head details.kp-info{margin:0;position:static}
7:.cal .cal-head details.kp-info[open]>p{position:absolute;left:24px;right:24px;z-index:3;margin-top:8px}
8:.cal .cal-day{margin-left:auto;font:800 30px Cambria,serif;color:#5a3a18;white-space:nowrap}
9:.cal-tray{display:flex;align-items:center;justify-content:space-around;height:72px;margin:8px 0 12px;padding:0 22px;background:var(--cal-tray) center/100% 100% no-repeat}
10:.cal-gift{display:flex;align-items:center;gap:8px}
11:.cal-gift img{width:50px;height:50px;object-fit:contain;filter:drop-shadow(0 2px 2px #0006)}
12:.cal-gift b{font:800 32px Cambria,serif;color:#4a2a12}
13:.cal-grid{display:grid;grid-template-columns:repeat(7,81px);grid-auto-rows:74px;gap:8px;justify-content:center}
14:.cal-cell{position:relative;border:0;padding:0;cursor:pointer;background:var(--cal-cell) center/100% 100% no-repeat;display:flex;flex-direction:column;align-items:center;justify-content:flex-start}
15:.cal-cell.is-claimed{background-image:var(--cal-cell-claimed)}
16:.cal-cell.is-today{background-image:var(--cal-cell-today);animation:cal-glow 1.8s ease-in-out infinite}
17:.cal-cell.is-missed,.cal-cell.is-future{background-image:var(--cal-cell-dim)}
18:.cal-cell.is-none .cal-n{opacity:.55}
19:.cal-n{margin-top:7px;font:800 30px/1 Cambria,serif;color:#4a2a12}
20:.cal-cell.is-future .cal-n,.cal-cell.is-missed .cal-n{color:#6a5640}
21:.cal-mark{width:34px;height:34px;object-fit:contain;margin-top:2px}
22:.cal-mark.lock{width:28px;height:28px;opacity:.85}
23:.cal-mark.gift{width:38px;height:38px;filter:drop-shadow(0 0 6px rgba(255,190,80,.8))}
24:.cal-mark.small{position:absolute;left:2px;bottom:2px;width:24px;height:24px}
25:.cal-chest{position:relative;display:block;width:52px;height:38px;margin-top:1px}
26:.cal-chest img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 2px #0007)}
27:.cal-chest b{position:absolute;right:-12px;bottom:-6px;font:900 21px/1 Cambria,serif;color:#fff3cf;text-shadow:0 0 3px #1a0c04,0 2px 2px #1a0c04}
28:.cal-chest.is-ready img{filter:drop-shadow(0 0 8px rgba(255,200,90,.95))}
29:.cal-chest.is-done img{filter:grayscale(.4) brightness(.85)}
30:.cal-chest-done{position:absolute;left:12px;top:4px;width:28px;height:28px}
31:.cal-foot{display:flex;gap:12px;justify-content:center;margin-top:12px}
32:.cal-claim{min-width:420px;min-height:72px;font-size:33px!important}
33:.cal-claim.is-done{filter:saturate(.45) brightness(.9)}
34:.cal-voucher{min-height:72px;display:flex;align-items:center;gap:8px}
35:.cal-ticket{width:40px;height:40px;object-fit:contain}
36:.cal-cell:focus-visible{outline:4px solid #fff1b8;outline-offset:2px}
37:.cal-pop-date{text-align:center;font:700 26px Cambria,serif;margin:4px 0 2px;color:#6a4a28}
38:.cal-pop-state{text-align:center;font:800 30px Cambria,serif;margin:0 0 6px;color:#4a2a12}
39:.cal-pop-state.is-missed{color:#7a3a22}
40:@keyframes cal-glow{50%{filter:brightness(1.12) drop-shadow(0 0 8px rgba(255,190,80,.7))}}
41:@media (prefers-reduced-motion:reduce){.cal-cell.is-today{animation:none}}
43:.cal-cell.is-last .cal-n{position:absolute;left:7px;top:4px;margin:0;font-size:23px}
