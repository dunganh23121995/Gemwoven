{
  "_doc": "Every item a hero must have, checked by scripts/hero_checklist.py and shown as a grid in the hero studio (tools/hero-gallery.html, 'Hạng mục tướng'). Add a new item here and every hero that lacks it shows a red cell. Path placeholders: {key} hero key, {form} form number, {formdir} that form's combat folder, {kit} its combat kit file, {name} lower-case display name. 'forms': which forms the item applies to ('all', '1', '2-3', '3'). 'paths': files of which at least one must exist (glob), optionally per form scope; 'grep': [file glob, regex] that must match. 'byHero' replaces the check for one hero. 'optional': shown in grey when missing.",
  "heroes": {
    "shadow": {"name": "noct", "kit": "src/shadow-combat.js", "form1dir": "assets/heroes/shadow"},
    "fire": {"name": "mika", "kit": "src/forms-mika.js", "form1dir": "assets/reimagined/heroes/fire"},
    "ice": {"name": "yuki", "kit": "src/forms-yuki.js", "form1dir": "assets/reimagined/heroes/ice"},
    "earth": {"name": "nori", "kit": "src/forms-nori.js", "form1dir": "assets/reimagined/heroes/earth"},
    "lightning": {"name": "lumi", "kit": "src/forms-lumi.js", "form1dir": "assets/reimagined/heroes/lightning"},
    "novice": {"name": "hiro", "kit": "src/forms-tan.js", "form1dir": "assets/heroes/novice", "forms": 1}
  },
  "items": [
    {"id": "data", "group": "1. Thiết kế", "label": "Dữ liệu tướng và các dạng (tên, vũ khí, tuyệt kỹ)", "forms": "1",
     "grep": ["src/gemwoven/progression.js", "\\b{key}:\\{name:"]},
    {"id": "master", "group": "2. Hình chiến đấu", "label": "Ảnh gốc (master) của dạng", "forms": "all",
     "paths": {"1": ["assets/masters/{key}-transparent.png", "assets/heroes/novice/references/master.png", "assets/heroes/shadow/action-anchor.png"], "2-3": ["{formdir}/master.png"]}},
    {"id": "idle", "group": "2. Hình chiến đấu", "label": "Nghỉ trong trận: vòng 8 khung ổn định", "forms": "all",
     "paths": ["assets/heroes/forms/{key}/form-{form}/combat-idle/idle.webp", "assets/heroes/forms/shadow/idle-cloth/form-{form}/frame-07.png"]},
    {"id": "attack", "group": "2. Hình chiến đấu", "label": "Sheet đánh thường", "forms": "all", "paths": ["{formdir}/attack.webp"]},
    {"id": "cast", "group": "2. Hình chiến đấu", "label": "Sheet thi triển", "forms": "all", "paths": ["{formdir}/cast.webp"]},
    {"id": "move", "group": "2. Hình chiến đấu", "label": "Sheet di chuyển (chạy, hoặc bay với tướng bay)", "forms": "all", "paths": ["{formdir}/run.webp", "{formdir}/hover.webp"]},
    {"id": "skill", "group": "2. Hình chiến đấu", "label": "Tư thế tuyệt kỹ riêng của dạng (skill/press/slash...)", "forms": "2-3", "optional": true,
     "paths": ["{formdir}/skill.webp", "{formdir}/press.webp", "{formdir}/slash.webp"]},
    {"id": "head-scale", "group": "2. Hình chiến đấu", "label": "Đã đo đầu (thân cùng cỡ ở mọi dạng, trận và trình diễn)", "forms": "all",
     "grep": ["assets/heroes/head-scale.json", "\"{key}-{form}\": \\{\"combat\": \\{[^\\n]*\"headPx\": [0-9.]+[^\\n]*\"showcase\": \\{[^\\n]*\"headPx\": [0-9.]+"]},
    {"id": "showcase-master", "group": "3. Trình diễn ngoài trận", "label": "Tư thế trình diễn", "forms": "all", "paths": ["assets/heroes/forms/{key}/form-{form}/showcase/master.png"]},
    {"id": "showcase-idle", "group": "3. Trình diễn ngoài trận", "label": "Vòng nghỉ trình diễn", "forms": "all", "paths": ["assets/heroes/forms/{key}/form-{form}/showcase/idle.webp"]},
    {"id": "showcase-fidgets", "group": "3. Trình diễn ngoài trận", "label": "2 hành động thỉnh thoảng", "forms": "all", "fidgets": 2},
    {"id": "entrance", "group": "3. Trình diễn ngoài trận", "label": "Màn xuất hiện riêng (triệu hồi)", "forms": "all",
     "paths": ["assets/heroes/forms/{key}/form-{form}/showcase/entrance.webp", "assets/heroes/forms/{key}/form-{form}/showcase/rift.webp"]},
    {"id": "aura", "group": "4. Chiến đấu", "label": "Hào quang dạng 3", "forms": "3", "paths": ["assets/heroes/forms/{key}/aura.json"]},
    {"id": "kit", "group": "4. Chiến đấu", "label": "Bộ chiêu riêng của dạng (tuyệt kỹ, đánh thường, rời sân)", "forms": "2-3",
     "grep": ["{kit}", "HERO_KITS\\.{key}\\s*="], "byHero": {"shadow": {"grep": ["src/shadow-combat.js", "reaperForm"]}, "novice": {"grep": ["src/forms-tan.js", "HERO_KITS\\.novice\\s*="], "forms": "1"}}},
    {"id": "fx", "group": "4. Chiến đấu", "label": "Hiệu ứng tuyệt kỹ riêng (FX)", "forms": "2-3",
     "paths": ["assets/fx/heroes/{key}/fx.json"], "byHero": {"shadow": {"paths": ["assets/fx/noct/fx.json"]}, "novice": {"paths": ["assets/fx/heroes/novice/fx.json"], "forms": "1"}}},
    {"id": "depart", "group": "4. Chiến đấu", "label": "Rời sân có dấu ấn riêng", "forms": "3",
     "grep": ["src/hero-departures.js", "\\b{key}:\\{name:"], "byHero": {"shadow": {"grep": ["src/shadow-combat.js", "noctSoul"]}, "novice": {"grep": ["src/hero-departures.js", "novice:\\{name:"], "forms": "1"}}},
    {"id": "voice", "group": "5. Âm thanh", "label": "Giọng nhân vật (hô, bị đánh)", "forms": "1", "optional": true,
     "grep": ["assets/audio/cast-voice-manifest.json", "\"{name}-"], "byHero": {"shadow": {"paths": ["assets/audio/noct-manifest.json"]}}},
    {"id": "sounds", "group": "5. Âm thanh", "label": "Âm thanh tuyệt kỹ riêng (bản thu thật)", "forms": "2-3",
     "paths": ["assets/audio/hero-forms/{key}-manifest.json"], "byHero": {"shadow": {"paths": ["assets/audio/noct-sfx-manifest.json"]}, "novice": {"paths": ["assets/audio/hero-forms/novice-manifest.json"], "forms": "1"}}},
    {"id": "portrait", "group": "6. Hub và triệu hồi", "label": "Chân dung", "forms": "2-3", "paths": ["{formdir}/portrait.png"]},
    {"id": "fragment", "group": "6. Hub và triệu hồi", "label": "Mảnh tướng (mảnh ghép tranh)", "forms": "1",
     "grep": ["assets/gemwoven/manifest.json", "\"fragment-{key}\""]},
    {"id": "locked", "group": "7. Duyệt", "label": "Người chơi đã duyệt và khóa", "forms": "1", "paths": ["assets/heroes/forms/{key}/LOCKED.txt"]}
  ]
}
