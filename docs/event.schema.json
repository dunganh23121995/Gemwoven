{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemwoven coming-soon event configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "enabled", "status", "startsAt", "endsAt", "banner", "order"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{1,50}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 1200},
    "enabled": {"type": "boolean"},
    "status": {"const": "coming-soon"},
    "startsAt": {"type": "string", "description": "ISO date-time, or empty for immediate visibility"},
    "endsAt": {"type": "string", "description": "ISO date-time after startsAt, or empty"},
    "banner": {"enum": ["icon-event", "icon-gift", "icon-arena", "chest"]},
    "order": {"type": "integer", "minimum": 0, "maximum": 999}
  }
}
